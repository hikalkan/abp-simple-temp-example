{
  "runtime": "dotnet",
  "init": [
    "dotnet restore AbpTempSimpleApp/AbpTempSimpleApp.csproj",
    "ASPNETCORE_ENVIRONMENT=Development App__SelfUrl=http://localhost:8080 AuthServer__Authority=http://localhost:8080 dotnet run --project AbpTempSimpleApp/AbpTempSimpleApp.csproj --no-launch-profile -- --migrate-database"
  ],
  "run": "ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://0.0.0.0:8080 App__SelfUrl=http://localhost:8080 AuthServer__Authority=http://localhost:8080 App__HealthCheckUrl=http://localhost:8080/health-status dotnet run --project AbpTempSimpleApp/AbpTempSimpleApp.csproj --no-launch-profile",
  "port": 8080,
  "healthcheck": "/health-status"
}
