{
  // Taskever sandbox: clone → /home/user/workspace (repo root)
  // Template must provide: .NET SDK 10, Node 20 LTS (npm 10 bundled), Volo.Abp.Studio.Cli.
  // Do NOT run "rm .../npm" or corepack here — if corepack fails, npm is deleted and init breaks.
  "runtime": "dotnet",

  "init": [
    "dotnet restore AbpTempSimpleApp/AbpTempSimpleApp.csproj",
    "dotnet build AbpTempSimpleApp/AbpTempSimpleApp.csproj -v q --nologo",
    "export PATH=/usr/local/bin:$PATH && npm --version",
    "export PATH=/usr/local/bin:$PATH && npm install --prefix AbpTempSimpleApp --ignore-engines",
    "abp install-libs --working-directory AbpTempSimpleApp",
    "ConnectionStrings__Default='Data Source=AbpTempSimpleApp.db' App__SelfUrl=http://127.0.0.1:8080 App__HealthCheckUrl=http://127.0.0.1:8080/health-status ASPNETCORE_URLS=http://0.0.0.0:8080 ASPNETCORE_ENVIRONMENT=Development dotnet run --project AbpTempSimpleApp --migrate-database --no-launch-profile --no-build"
  ],

  "run": "ConnectionStrings__Default='Data Source=AbpTempSimpleApp.db' App__SelfUrl=http://127.0.0.1:8080 App__HealthCheckUrl=http://127.0.0.1:8080/health-status ASPNETCORE_URLS=http://0.0.0.0:8080 ASPNETCORE_ENVIRONMENT=Development dotnet run --project AbpTempSimpleApp --no-build --no-launch-profile",

  "port": 8080,

  "healthcheck": "/health-status"
}
